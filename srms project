int main(void) {
    int choice;

    while (1) {
        printf("\n================ LOGIN TYPE SELECTION ================\n");
        printf("1. Admin Login\n");
        printf("2. Staff Login\n");
        printf("3. Guest Login\n");
        printf("4. Exit Program\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1: if (loginSystem("admin")) mainMenu(); else printf("Invalid admin.\n"); break;
        case 2: if (loginSystem("staff")) mainMenu(); else printf("Invalid staff.\n"); break;
        case 3: if (loginSystem("guest")) mainMenu(); else printf("Invalid guest.\n"); break;
        case 4: printf("Bye!\n"); return 0;
        default: printf("Invalid choice.\n");
        }
    }
}

// ---------------------------------------------------------

int loginSystem(const char *expectedRole) {
    char username[20], password[20], fileUser[20], filePass[20], fileRole[20];

    printf("\nLOGIN (%s)\n", expectedRole);
    printf("Username: "); scanf("%19s", username);
    printf("Password: "); scanf("%19s", password);

    FILE *fp = fopen(CREDENTIAL_FILE, "r");
    if (!fp) return 0;

    while (fscanf(fp, "%19s %19s %19s", fileUser, filePass, fileRole) == 3) {
        if (strcmp(username, fileUser) == 0 &&
            strcmp(password, filePass) == 0 &&
            strcmp(fileRole, expectedRole) == 0) {

            strcpy(currentUser, fileUser);
            strcpy(currentRole, fileRole);
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

// ---------------------------------------------------------

void mainMenu(void) {
    printf("\nLogged in as: %s (%s)\n", currentUser, currentRole);

    if (strcmp(currentRole, "admin") == 0) adminMenu();
    else if (strcmp(currentRole, "staff") == 0) staffMenu();
    else guestMenu();
}

