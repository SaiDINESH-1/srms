// ADD STUDENT 

void addStudent(void) {
    FILE *fp = fopen(STUDENT_FILE, "a");
    struct Student st;

    if (!fp) { printf("Error!\n"); return; }

    printf("Reg ID: "); scanf("%19s", st.regID);

    getchar();
    printf("Name: "); fgets(st.name, 50, stdin); st.name[strcspn(st.name, "\n")] = 0;

    printf("CGPA: "); scanf("%f", &st.cgpa);

    getchar();
    printf("Section: "); fgets(st.section, 20, stdin); st.section[strcspn(st.section, "\n")] = 0;

    printf("Branch: "); fgets(st.branch, 50, stdin); st.branch[strcspn(st.branch, "\n")] = 0;

    printf("Phone: "); scanf("%14s", st.phone);

    fprintf(fp, "%s|%s|%.2f|%s|%s|%s\n",
            st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);

    fclose(fp);
    printf("Student Added.\n");
}

// ---------------------------------------------------------

void displayStudents(void) {
    FILE *fp = fopen(STUDENT_FILE, "r");
    struct Student st;

    if (!fp) { printf("No records.\n"); return; }

    printf("\nRegID\tName\tCGPA\tSection\tBranch\tPhone\n");
    printf("--------------------------------------------------------\n");

    while (fscanf(fp, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone) == 6) {

        printf("%s\t%s\t%.2f\t%s\t%s\t%s\n",
               st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
    }

    fclose(fp);
}

// ---------------------------------------------------------

void searchStudent(void) {
    FILE *fp = fopen(STUDENT_FILE, "r");
    struct Student st;
    char id[20];
    int found = 0;

    if (!fp) { printf("No records.\n"); return; }

    printf("Enter RegID: "); scanf("%19s", id);

    while (fscanf(fp, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone) == 6) {

        if (strcmp(st.regID, id) == 0) {
            printf("\nFound:\n");
            printf("RegID: %s\nName: %s\nCGPA: %.2f\nSection: %s\nBranch: %s\nPhone: %s\n",
                   st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
            found = 1;
        }
    }

    if (!found) printf("Not found.\n");

    fclose(fp);
}

// ---------------------------------------------------------

void updateStudent(void) {
    FILE *fp = fopen(STUDENT_FILE, "r");
    FILE *temp = fopen("temp.txt", "w");
    struct Student st;
    char id[20];
    int found = 0;

    if (!fp || !temp) { printf("Error.\n"); return; }

    printf("Enter RegID to Update: ");
    scanf("%19s", id);

    getchar();

    while (fscanf(fp, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone) == 6) {

        if (strcmp(st.regID, id) == 0) {
            found = 1;

            printf("New Name: "); fgets(st.name, 50, stdin); st.name[strcspn(st.name, "\n")] = 0;
            printf("New CGPA: "); scanf("%f", &st.cgpa);
            getchar();
            printf("New Section: "); fgets(st.section, 20, stdin); st.section[strcspn(st.section, "\n")] = 0;
            printf("New Branch: "); fgets(st.branch, 50, stdin); st.branch[strcspn(st.branch, "\n")] = 0;
            printf("New Phone: "); scanf("%14s", st.phone);
        }

        fprintf(temp, "%s|%s|%.2f|%s|%s|%s\n",
                st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
    }

    fclose(fp);
    fclose(temp);

    remove(STUDENT_FILE);
    rename("temp.txt", STUDENT_FILE);

    printf(found ? "Student Updated.\n" : "Not found.\n");
}

// ---------------------------------------------------------

void deleteStudent(void) {
    FILE *fp = fopen(STUDENT_FILE, "r");
    FILE *temp = fopen("temp.txt", "w");
    struct Student st;
    char id[20];
    int found = 0;

    printf("Enter RegID to Delete: ");
    scanf("%19s", id);

    while (fscanf(fp, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone) == 6) {

        if (strcmp(st.regID, id) == 0) { found = 1; continue; }

        fprintf(temp, "%s|%s|%.2f|%s|%s|%s\n",
                st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
    }

    fclose(fp);
    fclose(temp);

    remove(STUDENT_FILE);
    rename("temp.txt", STUDENT_FILE);

    printf(found ? "Deleted.\n" : "Not found.\n");
}

