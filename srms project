// ---------------------------------------------------------
// ADMIN APPROVE REQUESTS
// ---------------------------------------------------------

void approveAddRequest(void) {
    FILE *req = fopen(ADD_REQUEST_FILE, "r");
    FILE *temp = fopen("temp_req.txt", "w");
    struct Student st;
    char target[20];
    int found = 0;

    if (!req || !temp) { printf("Error.\n"); return; }

    printf("Enter RegID to Approve: ");
    scanf("%19s", target);

    while (fscanf(req, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone)==6) {

        if (strcmp(st.regID, target) == 0) {
            found = 1;

            FILE *stu = fopen(STUDENT_FILE, "a");
            fprintf(stu, "%s|%s|%.2f|%s|%s|%s\n",
                    st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
            fclose(stu);

            continue;
        }

        fprintf(temp, "%s|%s|%.2f|%s|%s|%s\n",
                st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
    }

    fclose(req);
    fclose(temp);

    remove(ADD_REQUEST_FILE);
    rename("temp_req.txt", ADD_REQUEST_FILE);

    printf(found ? "Add Request Approved.\n" : "Request Not Found.\n");
}

// ---------------------------------------------------------

void updateStudentFromRequest(struct Student stNew) {
    FILE *fp = fopen(STUDENT_FILE, "r");
    FILE *temp = fopen("temp2.txt", "w");
    struct Student st;

    while (fscanf(fp, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone)==6) {

        if (strcmp(st.regID, stNew.regID) == 0) {
            fprintf(temp, "%s|%s|%.2f|%s|%s|%s\n",
                    stNew.regID, stNew.name, stNew.cgpa,
                    stNew.section, stNew.branch, stNew.phone);
        } else {
            fprintf(temp, "%s|%s|%.2f|%s|%s|%s\n",
                    st.regID, st.name, st.cgpa,
                    st.section, st.branch, st.phone);
        }
    }

    fclose(fp);
    fclose(temp);

    remove(STUDENT_FILE);
    rename("temp2.txt", STUDENT_FILE);
}

void approveUpdateRequest(void) {
    FILE *req = fopen(UPDATE_REQUEST_FILE, "r");
    FILE *temp = fopen("temp_upd.txt", "w");
    struct Student st;
    char target[20];
    int found = 0;

    if (!req || !temp) { printf("Error.\n"); return; }

    printf("Enter RegID to Approve Update: ");
    scanf("%19s", target);

    while (fscanf(req, "%19[^|]|%49[^|]|%f|%19[^|]|%49[^|]|%14[^\n]\n",
        st.regID, st.name, &st.cgpa, st.section, st.branch, st.phone)==6) {

        if (strcmp(st.regID, target) == 0) {
            found = 1;
            updateStudentFromRequest(st);
            continue;
        }

        fprintf(temp, "%s|%s|%.2f|%s|%s|%s\n",
                st.regID, st.name, st.cgpa, st.section, st.branch, st.phone);
    }

    fclose(req);
    fclose(temp);

    remove(UPDATE_REQUEST_FILE);
    rename("temp_upd.txt", UPDATE_REQUEST_FILE);

    printf(found ? "Update Request Approved.\n" : "Request Not Found.\n");
}
